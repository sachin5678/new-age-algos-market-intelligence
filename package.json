{
  "name": "new-age-algos-market-intel",
  "version": "0.1.0",
  "private": true,
  "description": "New Age Algos - Indian market intelligence pipeline (event-driven, dedup-first, Telegram alerts)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "intraday": "node src/index.js --mode intraday",
    "premarket": "node src/index.js --mode premarket --briefing premarket",
    "closing": "node src/index.js --mode closing --briefing closing",
    "market-check": "node src/index.js --mode intraday --job-type market-check",
    "health-check": "node src/index.js --health-check",
    "market-news": "node src/index.js --mode intraday --job-type market-news",
    "samples": "node scripts/print-samples.mjs",
    "render:premarket": "node scripts/render-preview.mjs premarket",
    "render:closing": "node scripts/render-preview.mjs closing",
    "render:alert": "node scripts/render-preview.mjs alert",
    "short": "node scripts/make-short.mjs",
    "recap": "node scripts/make-short.mjs --type recap",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "node-fetch": "^3.3.2",
    "puppeteer-core": "^25.12.0",
    "telegram": "^2.26.22"
  }
}
